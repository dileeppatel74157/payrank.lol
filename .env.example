# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to browser

# Razorpay (Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret       # set when you create the webhook in Razorpay dashboard

# Crypto payout address shown to bidders (USDT TRC20)
NEXT_PUBLIC_USDT_TRC20_ADDRESS=your-tron-wallet-address

# TronGrid API key (optional)
TRONGRID_API_KEY=your-trongrid-api-key

# Secret key for Cron authorization
CRON_SECRET=your-cron-secret-token

# FirstPromoter Configuration
NEXT_PUBLIC_FIRSTPROMOTER_CID=your-firstpromoter-cid
FIRSTPROMOTER_API_KEY=your-firstpromoter-api-key
FIRSTPROMOTER_ACCOUNT_ID=your-firstpromoter-account-id

# Configurable Referral and Processing Fees
REFERRAL_COMMISSION_PERCENTAGE=20
RAZORPAY_GST_PERCENTAGE=18
RAZORPAY_FEE_PERCENTAGE=2
RAZORPAY_FEE_FIXED=0
CRYPTO_GST_PERCENTAGE=0
CRYPTO_FEE_PERCENTAGE=0
CRYPTO_FEE_FIXED=0

